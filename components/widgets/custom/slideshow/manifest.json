{
  "title": "slideshow",
  "iconName": "Tv",
  "sizes": ["M", "L", "S"],
  "orientations": ["h"],
  "defaults": { "size": "M", "orientation": "h" },
  "settings": [
    {
      "key": "hoverExpand",
      "label": "slot hover expand",
      "type": "toggle",
      "default": true
    },
    {
      "key": "autoplay",
      "label": "autoplay",
      "type": "toggle",
      "default": true
    },
    {
      "key": "intervalSec",
      "label": "slide seconds",
      "type": "number",
      "default": 5,
      "min": 2,
      "max": 20
    },
    {
      "key": "fit",
      "label": "image fit",
      "type": "select",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "cover" },
        { "value": "contain", "label": "contain" }
      ]
    },
    {
      "key": "showCaptions",
      "label": "captions",
      "type": "toggle",
      "default": true
    }
  ]
}

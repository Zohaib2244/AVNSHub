{
  "title": "whatsapp",
  "iconName": "Wifi",
  "sizes": ["M", "L"],
  "orientations": ["h", "v"],
  "defaults": { "size": "M", "orientation": "h" },
  "settings": [
    {
      "key": "bridgeUrl",
      "label": "bridge url",
      "type": "text",
      "default": "",
      "placeholder": "http://127.0.0.1:3333"
    },
    {
      "key": "groupId",
      "label": "group id",
      "type": "text",
      "default": "",
      "placeholder": "120363...@g.us"
    },
    {
      "key": "displayName",
      "label": "display name",
      "type": "text",
      "default": "group chat"
    },
    {
      "key": "limit",
      "label": "message limit",
      "type": "number",
      "default": 20,
      "min": 5,
      "max": 50
    },
    {
      "key": "draftMode",
      "label": "draft mode",
      "type": "toggle",
      "default": true
    },
    {
      "key": "nutbotReplyEnabled",
      "label": "nutbot reads & replies",
      "type": "toggle",
      "default": false
    },
    {
      "key": "nutbotTrigger",
      "label": "reply trigger",
      "type": "select",
      "default": "mention",
      "options": [
        { "value": "mention", "label": "only when @nutbot is tagged" },
        { "value": "latest", "label": "every latest message" }
      ]
    },
    {
      "key": "nutbotPollSeconds",
      "label": "check interval (seconds)",
      "type": "number",
      "default": 30,
      "min": 10,
      "max": 300
    },
    {
      "key": "nutbotAutoSend",
      "label": "auto-send replies",
      "type": "toggle",
      "default": false
    },
    {
      "key": "nutbotReplyPrefix",
      "label": "prefix replies with \"nutbot: \"",
      "type": "toggle",
      "default": true
    },
    {
      "key": "nutbotBackend",
      "label": "reply llm",
      "type": "select",
      "default": "bonfire",
      "options": [
        { "value": "bonfire", "label": "bonfire (local llm)" },
        { "value": "claude", "label": "claude" },
        { "value": "codex", "label": "codex" },
        { "value": "opencode", "label": "opencode" }
      ]
    },
    {
      "key": "nutbotBonfireNsfw",
      "label": "bonfire nsfw mode",
      "type": "toggle",
      "default": false
    }
  ]
}

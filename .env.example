# shared hub data (canvases, theme, layout, prefs, wallpaper) - SQLite via Prisma,
# lives on the host so every browser/device sees the same values. See docs/SETUP.md.
DATABASE_URL="file:./prisma/hub.db"

HOMELAB_STATUS_URL=
# set to "true" for local dev without a reachable homelab — serves realistic mock stats
HOMELAB_MOCK_DATA=

# Hosts allowed to load the dev server from another machine (comma-separated),
# e.g. a LAN IP or reverse-proxy name. Not needed on localhost.
ALLOWED_DEV_ORIGINS=
# Path to Uptime Kuma's kuma.db (read-only), for the Homelab Status widget.
UPTIME_KUMA_DB=
# Or a published Kuma status page URL (preferred when set).
UPTIME_KUMA_STATUS_PAGE=

